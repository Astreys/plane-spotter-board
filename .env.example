# Server
PORT=8787
HOST=0.0.0.0

# Comma-separated ICAO codes of airports to poll. Must exist in src/config/airports.ts
AIRPORTS=CYYZ

# Poll interval per airport, milliseconds. Global rate limit is enforced separately.
POLL_INTERVAL_MS=15000

# Search radius around the airport, nautical miles (API max 250)
SEARCH_RADIUS_NM=60

# Sent to the ADS-B aggregators. Identify the app honestly.
USER_AGENT=plane-spotter-board/0.1 (+https://github.com/Astreys/plane-spotter-board)

# Allowed browser origins for the API, comma separated. Empty = allow all (dev).
CORS_ORIGINS=
