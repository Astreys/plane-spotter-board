# Server
PORT=8787
HOST=0.0.0.0

# Comma-separated ICAO codes of airports to poll. Must exist in src/config/airports.ts
AIRPORTS=CYYZ

# Poll interval per airport, milliseconds. Global rate limit is enforced separately.
POLL_INTERVAL_MS=15000

# Search radius around the airport, nautical miles (API max 250)
SEARCH_RADIUS_NM=60

# Sent to the ADS-B aggregators. Identify the app honestly.
USER_AGENT=plane-spotter-board/0.1 (+https://github.com/Astreys/plane-spotter-board)

# Allowed browser origins for the API, comma separated. Empty = allow all (dev).
CORS_ORIGINS=

# --- Upcoming board (optional) ---
# Today's scheduled arrivals, from AeroDataBox via RapidAPI. Leave this unset and
# the app works exactly as before, with the Upcoming tab hidden.
#
# Free tier is 600 units/month and one schedule fetch costs 2, so ~300 fetches a
# month. At the 3h default that is 8/day, 480/month.
AERODATABOX_API_KEY=

# How often to refresh the schedule. Raise it if you are near the monthly cap.
SCHEDULE_REFRESH_MS=10800000

# How far ahead the Upcoming board looks. The endpoint caps this at 12.
SCHEDULE_WINDOW_HOURS=12
